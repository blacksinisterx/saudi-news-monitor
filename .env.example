# ---- Database (Supabase: Project Settings > Database > Connection string > Transaction pooler, port 6543) ----
# Local dev (npm run db:local) uses:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# ---- Auth (single-user app) ----
APP_PASSWORD=change-me-to-a-long-passphrase
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Shared secret the scheduler (Cloudflare Worker / npm run cron) sends as "Authorization: Bearer ..."
CRON_SECRET=generate-with-openssl-rand-hex-32

# ---- Web Push (npm run vapid) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- AI fallback chain (optional). Tried in AI_PROVIDER_ORDER; if all fail (or no keys) the rule-based summary is used.
# Which provider wrote each summary is shown on the story page, /status, and in processing_logs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# xAI Grok (x.ai) — different company from Groq; optional
GROK_API_KEY=
GROK_MODEL=grok-3-mini
AI_PROVIDER_ORDER=gemini,groq
# Optional extra OpenAI-compatible provider ("custom"): Groq / OpenAI / Ollama ...
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MIN_IMPORTANCE=high
AI_MAX_CALLS_PER_RUN=4

# ---- Misc ----
# Enables /test and POST /api/test/inject (keep false in production once verified)
ENABLE_TEST_MODE=true
# Used by scripts/cron-loop.mts
APP_URL=http://localhost:3000
